#: src/Plugin/Installer.php
msgid "The remote plugin package does not contain a folder with the desired slug and renaming did not work."
msgstr "Gói plugin từ xa không chứa thư mục với slug mong muốn và việc đổi tên không hoạt động."

#: src/Plugin/Installer.php
msgid "The remote plugin package consists of more than one file, but the files are not packaged in a folder."
msgstr "Gói plugin từ xa bao gồm nhiều hơn một file, nhưng các file không được đóng gói trong thư mục."

#: src/Plugin/Installer.php
msgid "Please contact the plugin provider and ask them to package their plugin according to the WordPress guidelines."
msgstr "Vui lòng liên hệ nhà cung cấp plugin và yêu cầu họ đóng gói plugin theo hướng dẫn của WordPress."

