#. Plugin Name of the plugin
msgid "Jankx Plugin Activation"
msgstr "Kích hoạt Plugin Jankx"

#. Description of the plugin
msgid "A modern, PSR-4 compliant WordPress plugin activation library."
msgstr "Thư viện kích hoạt plugin WordPress hiện đại, tuân thủ PSR-4."

#: src/Core/Config.php
msgid "Install Required Plugins"
msgstr "Cài đặt Plugin Bắt buộc"

#: src/Core/Config.php
msgid "Install Plugins"
msgstr "Cài đặt Plugin"

#: src/Core/Config.php
#, php-format
msgid "Installing Plugin: %s"
msgstr "Đang cài đặt Plugin: %s"

#: src/Core/Config.php
#, php-format
msgid "Updating Plugin: %s"
msgstr "Đang cập nhật Plugin: %s"

#: src/Core/Config.php
msgid "Something went wrong with the plugin API."
msgstr "Đã xảy ra lỗi với API plugin."

#: src/Core/Config.php
#, php-format
msgid "This theme requires the following plugin: %1$s."
msgid_plural "This theme requires the following plugins: %1$s."
msgstr[0] "Theme này yêu cầu plugin sau: %1$s."
msgstr[1] "Theme này yêu cầu các plugin sau: %1$s."

#: src/Core/Config.php
#, php-format
msgid "This theme recommends the following plugin: %1$s."
msgid_plural "This theme recommends the following plugins: %1$s."
msgstr[0] "Theme này đề xuất plugin sau: %1$s."
msgstr[1] "Theme này đề xuất các plugin sau: %1$s."

#: src/Core/Config.php
#, php-format
msgid "The following plugin needs to be updated to its latest version to ensure maximum compatibility with this theme: %1$s."
msgid_plural "The following plugins need to be updated to their latest version to ensure maximum compatibility with this theme: %1$s."
msgstr[0] "Plugin sau cần được cập nhật lên phiên bản mới nhất để đảm bảo tương thích tối đa với theme này: %1$s."
msgstr[1] "Các plugin sau cần được cập nhật lên phiên bản mới nhất để đảm bảo tương thích tối đa với theme này: %1$s."

#: src/Core/Config.php
#, php-format
msgid "There is an update available for: %1$s."
msgid_plural "There are updates available for the following plugins: %1$s."
msgstr[0] "Có bản cập nhật sẵn có cho: %1$s."
msgstr[1] "Có bản cập nhật sẵn có cho các plugin sau: %1$s."

#: src/Core/Config.php
#, php-format
msgid "The following required plugin is currently inactive: %1$s."
msgid_plural "The following required plugins are currently inactive: %1$s."
msgstr[0] "Plugin bắt buộc sau hiện không hoạt động: %1$s."
msgstr[1] "Các plugin bắt buộc sau hiện không hoạt động: %1$s."

#: src/Core/Config.php
#, php-format
msgid "The following recommended plugin is currently inactive: %1$s."
msgid_plural "The following recommended plugins are currently inactive: %1$s."
msgstr[0] "Plugin đề xuất sau hiện không hoạt động: %1$s."
msgstr[1] "Các plugin đề xuất sau hiện không hoạt động: %1$s."

#: src/Core/Config.php
msgid "Begin installing plugin"
msgid_plural "Begin installing plugins"
msgstr[0] "Bắt đầu cài đặt plugin"
msgstr[1] "Bắt đầu cài đặt các plugin"

#: src/Core/Config.php
msgid "Begin updating plugin"
msgid_plural "Begin updating plugins"
msgstr[0] "Bắt đầu cập nhật plugin"
msgstr[1] "Bắt đầu cập nhật các plugin"

#: src/Core/Config.php
msgid "Begin activating plugin"
msgid_plural "Begin activating plugins"
msgstr[0] "Bắt đầu kích hoạt plugin"
msgstr[1] "Bắt đầu kích hoạt các plugin"

#: src/Core/Config.php
msgid "Return to Required Plugins Installer"
msgstr "Quay lại Trình cài đặt Plugin Bắt buộc"

#: src/Core/Config.php
msgid "Return to the Dashboard"
msgstr "Quay lại Bảng điều khiển"

#: src/Core/Config.php
msgid "Plugin activated successfully."
msgstr "Plugin đã được kích hoạt thành công."

#: src/Core/Config.php
#, php-format
msgid "No action taken. Plugin %1$s was already active."
msgstr "Không thực hiện hành động nào. Plugin %1$s đã hoạt động rồi."

#: src/Core/Config.php
#, php-format
msgid "Plugin not activated. A higher version of %s is needed for this theme. Please update the plugin."
msgstr "Plugin không được kích hoạt. Phiên bản cao hơn của %s là cần thiết cho theme này. Vui lòng cập nhật plugin."

#: src/Core/Config.php
#, php-format
msgid "All plugins installed and activated successfully. %1$s"
msgstr "Tất cả plugin đã được cài đặt và kích hoạt thành công. %1$s"

#: src/Core/Config.php
msgid "Dismiss this notice"
msgstr "Ẩn thông báo này"

#: src/Core/Config.php
msgid "There are one or more required or recommended plugins to install, update or activate."
msgstr "Có một hoặc nhiều plugin bắt buộc hoặc đề xuất cần cài đặt, cập nhật hoặc kích hoạt."

#: src/Core/Config.php
msgid "Please contact the administrator of this site for help."
msgstr "Vui lòng liên hệ quản trị viên trang web này để được hỗ trợ."

